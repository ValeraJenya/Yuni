# Copy manually to infra/validation/.env.validation in the dedicated validation worktree.
# This file contains only synthetic placeholders. Do not use the root .env as input.
COMPOSE_PROJECT_NAME=yuni-validation
VALIDATION_ENVIRONMENT=yuni-audit-validation
VALIDATION_EXTERNAL_PROVIDERS=disabled
VALIDATION_DATABASE_NAME=yuni_validation_test
VALIDATION_POSTGRES_PORT=56032
VALIDATION_POSTGRES_USER=yuni_validation_user
VALIDATION_POSTGRES_PASSWORD=replace_with_a_fresh_synthetic_validation_password

# Runtime-only inputs. The real file must use a fresh synthetic password and remain untracked.
DATABASE_URL=postgresql://yuni_validation_user:replace_with_a_fresh_synthetic_validation_password@127.0.0.1:56032/yuni_validation_test?schema=public
TEST_DATABASE_URL=postgresql://yuni_validation_user:replace_with_a_fresh_synthetic_validation_password@127.0.0.1:56032/yuni_validation_test?schema=public

# Set these to canonical paths in the separate validation worktree before any runtime work.
VALIDATION_WORKTREE_ROOT=C:\\path\\to\\yuni-validation-worktree
VALIDATION_MEDIA_ROOT=C:\\path\\to\\yuni-validation-worktree\\apps\\backend\\uploads
