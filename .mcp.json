{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ],
      "env": {}
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph-mcp",
      "args": [
        "--profile",
        "core"
      ],
      "env": {
        "CODEGRAPH_TELEMETRY": "off"
      }
    }
  }
}